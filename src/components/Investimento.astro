---
import p from "../data/proposta.json";
const brl = (n: number) => n.toLocaleString("pt-BR");
---
<section id="investimento" class="section investimento tone-pink50 corners sheet" data-investimento>
  <div class="wrap">
    <div class="investimento__head">
      <div>
        <p class="label eyebrow">Sinal 06 · Investimento</p>
        <h2 class="h2 investimento__title" data-fade>Três formas de começar. Uma recomendada.</h2>
      </div>
      <label class="switch">
        <input class="switch__input" type="checkbox" role="switch" data-vista-toggle />
        <span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
        <span class="label">Pagamento à vista na assinatura (−5%)</span>
      </label>
    </div>
    <div class="investimento__grid">
      {p.pacotes.map((k) => (
        <article class:list={["pack", `tone-${k.tom}`, { "pack--destaque": k.destaque }]} data-card>
          <header class="pack__head">
            <span class="label pack__rotulo">{k.rotulo}</span>
            <h3 class="pack__name">{k.nome}</h3>
          </header>
          <p class="pack__price">
            <span class="sr-only" data-price-sr>R$ {brl(k.valor)}</span>
            <span aria-hidden="true">
              <span class="pack__cur">R$</span>
              <span data-count={k.valor} data-vista={Math.round(k.valor * 0.95)}>{brl(k.valor)}</span>
            </span>
            <span class="label pack__off" aria-hidden="true">−5%</span>
          </p>
          <p class="label">{k.semanas} semanas · {k.horas} horas</p>
          <ul>{k.itens.map((i) => <li>{i}</li>)}</ul>
        </article>
      ))}
    </div>
    <div class="investimento__foot">
      <p class="label">Taxa-hora R$ 180 · impostos inclusos · válida até {p.validade}</p>
      <p class="sr-only" aria-live="polite" data-vista-status></p>
    </div>
  </div>
</section>

<style>
  .investimento__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 28px 48px; }
  .investimento__title { max-width: 16ch; }
  .investimento__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter); margin-top: clamp(48px, 5vw, 80px); align-items: stretch; }
  .pack {
    position: relative;
    border-radius: var(--radius); padding: clamp(24px, 2.4vw, 36px);
    display: grid; gap: 20px; align-content: start;
    border: 2px solid var(--baits-chocolate);
  }
  .pack--destaque { translate: 0 -16px; box-shadow: 0 0 0 3px var(--baits-chocolate), 0 24px 48px -24px color-mix(in srgb, var(--baits-chocolate) 55%, transparent); }
  .pack--destaque .pack__rotulo { justify-self: start; background: var(--baits-chocolate); color: var(--baits-pink); padding: 6px 12px; border-radius: 999px; }
  .pack__head { display: grid; gap: 10px; }
  .pack__name { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.25rem, 3.6vw, 3.5rem); line-height: 1; letter-spacing: -0.03em; }
  .pack__price {
    display: flex; align-items: start; flex-wrap: wrap; gap: 4px 10px;
    font-family: var(--font-display); font-weight: 800; font-size: clamp(2.5rem, 4.4vw, 4.5rem);
    line-height: 1; letter-spacing: -0.035em; font-variant-numeric: tabular-nums;
    padding-block: 12px 4px;
  }
  .pack__cur { font-size: 0.36em; letter-spacing: 0; vertical-align: top; margin-right: 6px; position: relative; top: 0.18em; }
  .pack__off {
    align-self: center; background: var(--baits-chocolate); color: var(--baits-yellow);
    padding: 5px 10px; border-radius: 999px; letter-spacing: 0.08em;
    opacity: 0; transform: translateY(6px) scale(0.9);
    transition: opacity 0.4s var(--ease-out), transform 0.5s var(--ease-out);
  }
  .is-vista .pack__off { opacity: 1; transform: none; }
  .pack ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .pack li { border-top: 1.5px solid currentColor; padding-block: 10px; }

  .investimento__foot { margin-top: clamp(32px, 3.4vw, 48px); }

  .switch {
    position: relative; display: inline-flex; align-items: center; gap: 14px; cursor: pointer;
    padding: 10px 18px 10px 10px; border-radius: 999px;
    border: 1.5px solid color-mix(in srgb, var(--baits-chocolate) 30%, transparent);
    transition: border-color 0.3s var(--ease-out);
  }
  .switch:hover { border-color: var(--baits-chocolate); }
  .switch__input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .switch__track {
    position: relative; flex: none; width: 52px; height: 30px; border-radius: 999px;
    border: 2px solid var(--baits-chocolate); background: transparent;
    transition: background-color 0.35s var(--ease-out);
  }
  .switch__thumb {
    position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%;
    background: var(--baits-chocolate);
    transition: transform 0.45s var(--ease-out), background-color 0.35s var(--ease-out);
  }
  .switch__input:checked + .switch__track { background: var(--baits-chocolate); }
  .switch__input:checked + .switch__track .switch__thumb { transform: translateX(22px); background: var(--baits-yellow); }
  .switch:hover .switch__track { background: color-mix(in srgb, var(--baits-chocolate) 12%, transparent); }
  .switch:hover .switch__input:checked + .switch__track { background: var(--baits-chocolate); }
  .switch__input:focus-visible + .switch__track { outline: 3px solid var(--focus); outline-offset: 4px; }

  @media (max-width: 900px) {
    .investimento__grid { grid-template-columns: 1fr; }
    .pack--destaque { translate: none; }
  }
</style>
