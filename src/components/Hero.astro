---
import p from "../data/proposta.json";
import { hasPublic } from "../lib/assets";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const hasPdf = hasPublic(p.pdf);
---
<section id="topo" class="hero tone-choc corners">
  <div class="wrap hero__grid">
    <p class="label hero__eyebrow" data-fade>Proposta comercial · Nutrição cognitiva</p>
    <h1 class="display hero__title" data-fade>
      Se o músculo tem nutrição, <em>por que a mente não?</em>
    </h1>
    <div class="hero__foot" data-hero-in>
      <dl class="hero__meta label">
        <div><dt>Cliente</dt><dd>{p.cliente}</dd></div>
        <div><dt>Proponente</dt><dd>{p.proponente}</dd></div>
        <div><dt>Data</dt><dd>{p.data}</dd></div>
        <div><dt>Válida até</dt><dd>{p.validade}</dd></div>
      </dl>
      <div class="hero__ctas">
        <a class="btn btn--solid" href="#investimento">
          Ver investimento
          <svg class="btn__icon btn__icon--down" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1v11M2 7.5 7 12.5l5-5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        </a>
        {hasPdf && (
          <a class="btn" href={`${base}/${p.pdf}`} download>
            Baixar PDF
            <svg class="btn__icon btn__icon--down" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1v8M3 5.5 7 9.5l4-4M1.5 13h11" fill="none" stroke="currentColor" stroke-width="2" /></svg>
          </a>
        )}
      </div>
    </div>

    <figure class="stage3d" aria-hidden="true" data-hero-visual>
      <span class="stage3d__disc" data-hero-disc></span>
      <span class="stage3d__ring"></span>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex; align-items: end;
    padding-block: clamp(104px, 15vh, 160px) clamp(56px, 9vh, 96px);
    overflow: hidden;
  }
  .hero__grid {
    display: grid; width: 100%;
    grid-template-columns: minmax(0, 1fr) clamp(300px, 40vw, 680px);
    grid-template-areas:
      "eyebrow visual"
      "title   visual"
      "foot    foot";
    column-gap: clamp(24px, 3vw, 56px);
    row-gap: clamp(20px, 3.4vh, 40px);
    align-items: end;
  }
  .hero__eyebrow { grid-area: eyebrow; color: var(--baits-yellow); position: relative; z-index: 1; }
  .hero__title {
    grid-area: title;
    font-size: clamp(3.25rem, min(8.4vw, 15vh), 11rem);
    max-width: 11ch;
    color: var(--baits-pink);
    position: relative; z-index: 1;
  }
  .hero__title em { font-style: normal; color: var(--baits-pink-50); }
  .hero__foot {
    grid-area: foot;
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 28px 48px;
    padding-top: clamp(20px, 3vh, 32px);
    border-top: 1px solid color-mix(in srgb, var(--baits-pink) 22%, transparent);
    position: relative; z-index: 1;
  }
  .hero__meta { display: grid; grid-template-columns: repeat(4, auto); gap: 12px clamp(24px, 3.5vw, 56px); margin: 0; }
  .hero__meta dt { color: color-mix(in srgb, var(--baits-pink-50) 64%, var(--baits-chocolate)); }
  .hero__meta dd { margin: 6px 0 0; color: var(--baits-pink-50); }
  .hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  /* Palco gráfico: disco amarelo com retícula e anel tracejado */
  .stage3d {
    grid-area: visual; align-self: stretch;
    position: relative; margin: 0;
    height: min(58vh, 600px); min-height: 300px;
    display: grid; place-items: center;
    isolation: isolate;
  }
  /* Disco e anel na mesma célula: centralizados pelo grid, sem translate
     (o GSAP grava translate: none ao animar a entrada) */
  .stage3d > * { grid-area: 1 / 1; }
  .stage3d__disc {
    position: relative; z-index: -2;
    width: min(100%, 56vh); aspect-ratio: 1; border-radius: 50%;
    margin-top: 4%;
    background:
      radial-gradient(60% 60% at 42% 36%, color-mix(in srgb, var(--baits-pink-50) 40%, var(--baits-yellow)) 0%, transparent 62%),
      var(--baits-yellow);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--baits-chocolate) 30%, transparent), 0 60px 120px -40px rgba(0, 0, 0, 0.55);
  }
  .stage3d__disc::after {
    /* retícula da marca */
    content: ""; position: absolute; inset: 0; border-radius: inherit;
    background-image: radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--baits-chocolate) 18%, transparent) 1.1px, transparent 0);
    background-size: 18px 18px;
    -webkit-mask: radial-gradient(closest-side, transparent 55%, #000 100%);
            mask: radial-gradient(closest-side, transparent 55%, #000 100%);
  }
  .stage3d__ring {
    position: relative; z-index: -3;
    width: min(116%, 68vh); aspect-ratio: 1; border-radius: 50%;
    margin-top: 4%;
    border: 1.5px dashed color-mix(in srgb, var(--baits-pink) 30%, transparent);
    animation: spin 60s linear infinite;
  }
  @keyframes spin { to { rotate: 360deg; } }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "visual" "eyebrow" "title" "foot";
    }
    .stage3d { min-height: 0; height: min(48svh, 100vw); }
    .stage3d__disc { width: min(84vw, 46svh); }
    .stage3d__ring { width: min(100vw, 56svh); }
    .hero__meta { grid-template-columns: repeat(2, auto); }
  }
  @media (max-width: 480px) {
    .hero__ctas, .hero__ctas .btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage3d__ring { animation: none; }
  }
</style>
