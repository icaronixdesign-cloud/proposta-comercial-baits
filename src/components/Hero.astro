---
import p from "../data/proposta.json";
import { hasPublic } from "../lib/assets";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const hasPdf = hasPublic(p.pdf);
const brl = (n: number) => n.toLocaleString("pt-BR");
const k = p.plano;
const vista = Math.round(k.valor * 0.95);
---
<section id="topo" class="hero tone-choc corners">
  <div class="wrap hero__grid">
    <p class="label hero__eyebrow" data-fade>Nutrição cognitiva · Estratégia, marca e digital</p>
    <h1 class="display hero__title" data-fade>
      Proposta Comercial <span class="hero__dash" aria-hidden="true">—</span> <em>BAITS</em>
    </h1>
    <blockquote class="hero__quote" data-fade>
      <p>“Se o músculo tem nutrição, por que a mente não?”</p>
    </blockquote>

    <div class="hero__foot" data-hero-in>
      <dl class="hero__meta label">
        <div><dt>Cliente</dt><dd>{p.cliente}</dd></div>
        <div><dt>Proponente</dt><dd>{p.proponente}</dd></div>
        <div><dt>Data</dt><dd>{p.data}</dd></div>
        <div><dt>Válida até</dt><dd>{p.validade}</dd></div>
      </dl>
      <div class="hero__ctas">
        <a class="btn btn--solid" href="#investimento">
          Ver investimento
          <svg class="btn__icon btn__icon--down" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1v11M2 7.5 7 12.5l5-5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        </a>
        {hasPdf && (
          <a class="btn" href={`${base}/${p.pdf}`} download>
            Baixar PDF
            <svg class="btn__icon btn__icon--down" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1v8M3 5.5 7 9.5l4-4M1.5 13h11" fill="none" stroke="currentColor" stroke-width="2" /></svg>
          </a>
        )}
      </div>
    </div>

    <!-- Resumo da proposta: o que o cliente precisa saber antes de rolar -->
    <aside class="ficha tone-pink50" aria-labelledby="ficha-title" data-hero-visual>
      <header class="ficha__head label">
        <span id="ficha-title">Resumo da proposta</span>
        <span>{p.data}</span>
      </header>
      <div class="ficha__plano">
        <p class="label">{k.rotulo}</p>
        <p class="ficha__nome">{k.nome}</p>
      </div>
      <dl class="ficha__rows">
        <div><dt class="label">Prazo</dt><dd>{k.semanas} semanas</dd></div>
        <div><dt class="label">Método</dt><dd>Double Diamond · {p.fases.length} fases</dd></div>
        <div><dt class="label">Dedicação</dt><dd>{k.horas} horas</dd></div>
        <div><dt class="label">Entregáveis</dt><dd>{p.entregaveis.length} frentes</dd></div>
        <div><dt class="label">Aprovações</dt><dd>{p.marcos.length} checkpoints com data</dd></div>
      </dl>
      <div class="ficha__total">
        <span class="label">Investimento total</span>
        <strong>R$ {brl(k.valor)}</strong>
        <span class="label ficha__vista">ou R$ {brl(vista)} à vista · −5%</span>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex; align-items: end;
    padding-block: clamp(104px, 15vh, 160px) clamp(56px, 9vh, 96px);
    overflow: hidden;
  }
  .hero__grid {
    display: grid; width: 100%;
    grid-template-columns: minmax(0, 1fr) clamp(320px, 31vw, 500px);
    grid-template-areas:
      "eyebrow visual"
      "title   visual"
      "quote   visual"
      "foot    foot";
    column-gap: clamp(32px, 5vw, 96px);
    row-gap: clamp(18px, 3vh, 36px);
    align-items: end;
  }
  .hero__eyebrow { grid-area: eyebrow; color: var(--baits-yellow); }
  .hero__title {
    grid-area: title;
    font-size: clamp(3rem, min(7.4vw, 14vh), 10rem);
    max-width: 10ch;
    color: var(--baits-pink);
    text-wrap: balance;
  }
  .hero__dash { color: var(--baits-yellow); font-weight: 500; }
  .hero__title em { font-style: normal; color: var(--baits-pink-50); }

  .hero__quote {
    grid-area: quote; margin: 0;
    padding-left: clamp(16px, 1.6vw, 24px);
    border-left: 3px solid var(--baits-yellow);
  }
  .hero__quote p {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.25rem, 1.9vw, 2rem); line-height: 1.2; letter-spacing: -0.015em;
    color: var(--baits-pink-50); max-width: 26ch;
  }

  .hero__foot {
    grid-area: foot;
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 28px 48px;
    padding-top: clamp(20px, 3vh, 32px);
    border-top: 1px solid color-mix(in srgb, var(--baits-pink) 22%, transparent);
  }
  .hero__meta { display: grid; grid-template-columns: repeat(4, auto); gap: 12px clamp(24px, 3.5vw, 56px); margin: 0; }
  .hero__meta dt { color: color-mix(in srgb, var(--baits-pink-50) 64%, var(--baits-chocolate)); }
  .hero__meta dd { margin: 6px 0 0; color: var(--baits-pink-50); }
  .hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  /* Ficha-resumo: papel claro sobre o chocolate */
  .ficha {
    grid-area: visual; align-self: end;
    border-radius: var(--radius);
    padding: clamp(20px, 1.9vw, 30px);
    display: grid; gap: clamp(14px, 2vh, 22px);
    box-shadow: 0 50px 100px -50px rgba(0, 0, 0, 0.7);
  }
  .ficha__head {
    display: flex; justify-content: space-between; gap: 12px;
    padding-bottom: 12px; border-bottom: 1.5px solid currentColor;
  }
  .ficha__plano { display: grid; gap: 6px; }
  .ficha__nome {
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(2rem, 2.9vw, 3rem); line-height: 0.95; letter-spacing: -0.035em;
  }
  .ficha__rows { margin: 0; display: grid; }
  .ficha__rows div {
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
    padding-block: clamp(7px, 1.1vh, 11px);
    border-bottom: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }
  .ficha__rows dd { margin: 0; font-weight: 600; text-align: right; }
  .ficha__total {
    display: grid; gap: 4px;
    padding: clamp(14px, 1.6vw, 20px);
    border-radius: calc(var(--radius) * 0.6);
    background: var(--baits-chocolate); color: var(--baits-pink-50);
  }
  .ficha__total strong {
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(2rem, 2.8vw, 2.875rem); line-height: 1; letter-spacing: -0.03em;
    color: var(--baits-yellow); font-variant-numeric: tabular-nums;
  }
  .ficha__vista { color: color-mix(in srgb, var(--baits-pink-50) 72%, transparent); }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "eyebrow" "title" "quote" "visual" "foot";
    }
    .ficha { margin-top: 8px; }
    .hero__meta { grid-template-columns: repeat(2, auto); }
  }
  @media (max-width: 480px) {
    .hero__ctas, .hero__ctas .btn { width: 100%; }
  }
</style>
