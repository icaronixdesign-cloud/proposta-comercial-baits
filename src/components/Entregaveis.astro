---
import p from "../data/proposta.json";
import { hasPublic } from "../lib/assets";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const total = String(p.entregaveis.length).padStart(2, "0");
const fases = new Map(p.fases.map((f) => [f.n, f]));
---
<section id="entregaveis" class="section h-section entregaveis tone-pink corners sheet" data-horizontal>
  <div class="wrap h-head">
    <div>
      <p class="label eyebrow">Sinal 04 · Entregáveis</p>
      <h2 class="h2" data-fade>Tudo o que sai daqui pronto para usar.</h2>
    </div>
    <p class="label h-meta" aria-hidden="true">
      <span class="h-count"><span data-counter>01</span> / {total}</span>
      <span class="h-hint--pin">Role para avançar ↓</span>
      <span class="h-hint--native">Arraste para o lado →</span>
    </p>
  </div>
  <div class="h-track" data-track tabindex="0" role="region" aria-label="Entregáveis, rolagem horizontal">
    {p.entregaveis.map((e, i) => {
      const n = String(i + 1).padStart(2, "0");
      const foto = hasPublic(e.img);
      const f = fases.get(e.fase);
      return (
        <article class:list={["card", `tone-${e.tom}`]}>
          <header class="card__head">
            <span class="card__n" aria-hidden="true">{n}</span>
            {f && (
              <p class="label card__fase">
                Fase {f.n}<br /><strong>{f.nome}</strong>
              </p>
            )}
          </header>
          {foto && (
            <figure class="card__foto">
              <img src={`${base}/${e.img}`} alt="" loading="lazy" decoding="async" width="1200" height="900" />
            </figure>
          )}
          <div class="card__text">
            <h3 data-panel-title><span class="sr-only">{n}. </span>{e.titulo}</h3>
            <p>{e.texto}</p>
          </div>
          <dl class="card__spec">
            {f && <div><dt class="label">Quando</dt><dd>{f.semanas}</dd></div>}
            {f && <div><dt class="label">Aprovação</dt><dd>{f.checkpoint}</dd></div>}
            <div><dt class="label">Revisões</dt><dd>Até 2 rodadas</dd></div>
          </dl>
        </article>
      );
    })}
  </div>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
</section>

<style>
  /* Ficha de cada entregável: número, fase, descrição e as condições de entrega */
  .card {
    width: min(84vw, 420px);
    display: flex; flex-direction: column; gap: clamp(16px, 2.4vh, 26px);
    padding: clamp(20px, min(2vw, 3vh), 30px);
    border-radius: var(--radius);
    border: 2px solid var(--baits-chocolate);
  }
  .card__head {
    display: flex; justify-content: space-between; align-items: start; gap: 16px;
    padding-bottom: clamp(12px, 1.8vh, 18px);
    border-bottom: 1.5px solid currentColor;
  }
  .card__n {
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(4.5rem, min(7vw, 13vh), 7.5rem); line-height: 0.8; letter-spacing: -0.06em;
  }
  .card__fase { text-align: right; }
  .card__fase strong { font-weight: 700; }
  .card__foto {
    margin: 0; aspect-ratio: 16 / 10; overflow: hidden;
    border-radius: calc(var(--radius) * 0.6);
  }
  .card__foto img { width: 100%; height: 100%; object-fit: cover; }
  .card__text { display: grid; gap: 8px; }
  .card h3 {
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(1.75rem, min(2.4vw, 4.4vh), 2.375rem); line-height: 0.98; letter-spacing: -0.025em;
  }
  .card__text p { max-width: 30ch; line-height: 1.45; min-height: calc(2 * 1.45em); }
  .card__spec { margin: auto 0 0; display: grid; }
  .card__spec div {
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
    padding-block: clamp(7px, 1.1vh, 10px);
    border-top: 1px solid color-mix(in srgb, currentColor 28%, transparent);
  }
  .card__spec dd { margin: 0; font-weight: 600; text-align: right; }

  /* Fixado: cartões na altura do próprio conteúdo, centralizados na faixa */
  .entregaveis.is-pinned .h-track { align-items: center; }
</style>
