---
import p from "../data/proposta.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<section id="entregaveis" class="section h-section entregaveis tone-pink corners" data-horizontal>
  <div class="wrap h-head">
    <div>
      <p class="label">Entregáveis</p>
      <h2 class="h2" data-fade>Tudo o que sai daqui pronto para usar.</h2>
    </div>
    <p class="label" aria-hidden="true">Arraste ou role →</p>
  </div>
  <div class="h-track" data-track>
    {p.entregaveis.map((e, i) => (
      <article class="card">
        <figure class={`visual tone-${e.tom}`}>
          <img src={`${base}/${e.img}`} alt="" loading="lazy" onerror="this.remove()" />
          <span class="label visual__tag">{String(i + 1).padStart(2, "0")}</span>
        </figure>
        <h3 data-panel-title>{e.titulo}</h3>
        <p>{e.texto}</p>
      </article>
    ))}
  </div>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
</section>

<style>
  .entregaveis .h2 { max-width: 16ch; margin-top: 20px; }
  .card { width: min(78vw, 460px); display: grid; gap: 12px; }
  .card .visual { border: 2px solid var(--baits-chocolate); }
  .card h3 { font-family: var(--font-display); font-weight: 800; font-size: 2rem; line-height: 1; margin-top: 8px; }
</style>
