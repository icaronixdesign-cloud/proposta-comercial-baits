---
import p from "../data/proposta.json";
import port from "../data/portfolio.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<section id="personagem" class="section personagem tone-lavender corners sheet" aria-labelledby="personagem-title">
  <div class="wrap personagem__grid">
    <div class="personagem__copy">
      <p class="label eyebrow">Prazer, em outra dimensão.</p>
      <h2 class="h2" id="personagem-title">Uma ideia.<br />Muitas possibilidades.</h2>
      <p class="lead">Esse sou eu, em versão 3D. Um último toque de criatividade antes de começarmos a construir o próximo capítulo da Baits.</p>
      <a class="btn btn--choc" href="#aceite">Vamos tirar do papel? ↗</a>
    </div>
    <div class="personagem__experience" data-character data-base={base}>
      <div class="personagem__stage" data-stage>
        <span class="label personagem__badge" aria-hidden="true">{p.proponente} · versão 3D</span>
        <img class="personagem__fallback" data-fallback src={`${base}/${port.retrato}-640.webp`} alt={`Retrato de ${p.proponente}, autor da proposta`} width="640" height="760" loading="lazy" />
        <canvas data-canvas tabindex="0" role="img" aria-label={`Personagem 3D de ${p.proponente}. Use as setas para girar, mais e menos para aproximar e afastar.`} aria-describedby="personagem-help" hidden></canvas>
        <p class="personagem__status label" data-status role="status">Preparando meu lado 3D…</p>
      </div>
      <div class="personagem__controls" role="group" aria-label="Interagir com o personagem">
        <button type="button" data-action="thumbs_up" disabled>Dar um joinha ✦</button>
        <button type="button" data-action="jump" disabled>Pular ↑</button>
        <button type="button" data-action="reset" disabled aria-label="Restaurar posição e zoom do personagem">Recomeçar ↺</button>
      </div>
      <p class="personagem__help label" id="personagem-help">Arraste para girar · use dois dedos para zoom<br />No teclado: setas para girar · + e − para zoom</p>
      <noscript><p>Ative o JavaScript para interagir com o personagem 3D.</p></noscript>
    </div>
  </div>
</section>
<script>
  const host = document.querySelector<HTMLElement>("[data-character]");
  if (host) {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      import("../scripts/personagem").then(({ initCharacter }) => initCharacter(host)).catch(() => {
        const status = host.querySelector<HTMLElement>("[data-status]");
        if (status) status.textContent = "O 3D não carregou. Meu retrato fica por aqui.";
      });
    }, { rootMargin: "400px" });
    observer.observe(host);
  }
</script>
<style>
  .personagem { padding-bottom: calc(var(--section-y) + var(--sheet-r)); }
  .personagem__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 100px); align-items: center; }
  .personagem__copy { display: grid; justify-items: start; gap: 28px; }
  .personagem__copy .eyebrow { margin: 0; }
  .personagem__copy .h2 { max-width: 16ch; }
  .personagem__copy .lead { max-width: 38ch; }
  .personagem__experience { min-width: 0; }
  .personagem__stage { position: relative; height: clamp(360px, 40vw, 540px); border: 2px solid var(--baits-chocolate); border-radius: 50% 50% var(--radius) var(--radius); overflow: hidden; background: radial-gradient(ellipse at 50% 40%, var(--baits-pink-50), var(--baits-pink)); }
  .personagem__stage canvas { display: block; width: 100%; height: 100%; touch-action: pan-y; }
  .personagem__stage canvas[hidden], .personagem__fallback[hidden] { display: none; }
  .personagem__stage canvas:focus-visible { outline-offset: -7px; border-radius: inherit; }
  .personagem__badge { position: absolute; top: 36px; left: 22%; right: 22%; text-align: center; z-index: 1; pointer-events: none; font-size: 9px; }
  .personagem__fallback { position: absolute; height: 82%; width: 85%; object-fit: contain; object-position: bottom; bottom: 0; left: 7.5%; }
  .personagem__status { position: absolute; bottom: 16px; left: 16px; right: 16px; text-align: center; padding: 8px 12px; border-radius: 16px; background: var(--baits-pink-50); font-size: 10px; pointer-events: none; }
  .personagem__controls { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 16px; }
  .personagem__controls button { min-height: 44px; padding: 10px 16px; border: 1.5px solid currentColor; border-radius: 999px; background: transparent; color: inherit; font: 600 0.85rem var(--font-body); cursor: pointer; }
  .personagem__controls button:enabled:hover { background: var(--baits-chocolate); color: var(--baits-pink-50); }
  .personagem__controls button:disabled { opacity: 0.45; cursor: default; }
  .personagem__help { text-align: center; margin-top: 14px; font-size: 10px; line-height: 1.8; letter-spacing: 0.04em; }
  @media (max-width: 900px) { .personagem__grid { grid-template-columns: 1fr; } .personagem__experience { width: min(100%, 520px); justify-self: center; } .personagem__stage { height: 440px; } }
  @media (max-width: 480px) { .personagem__stage { height: 380px; } .personagem__controls button { padding-inline: 12px; } }
</style>
