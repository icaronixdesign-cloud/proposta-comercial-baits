---
const links = [
  { href: "#metodo", label: "Método" },
  { href: "#entregaveis", label: "Entregáveis" },
  { href: "#investimento", label: "Investimento" },
  { href: "#condicoes", label: "Condições" },
];
---
<header class="nav">
  <div class="nav__bar">
    <a href="#topo" class="nav__mark" aria-label="Baits — topo">Baits</a>
    <nav aria-label="Seções">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="nav__cta" href="#aceite">Aceitar</a>
  </div>
  <div class="nav__progress" aria-hidden="true"><span data-page-progress></span></div>
</header>

<style>
  .nav { position: fixed; top: 12px; left: 0; right: 0; z-index: 50; padding-inline: var(--margin); pointer-events: none; }
  .nav__bar {
    pointer-events: auto;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 10px 10px 10px 20px;
    background: color-mix(in srgb, var(--baits-chocolate-90) 88%, transparent);
    backdrop-filter: blur(12px);
    border: 1px solid color-mix(in srgb, var(--baits-pink) 25%, transparent);
    border-radius: 999px;
    color: var(--baits-pink-50);
  }
  .nav__mark { font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; letter-spacing: -0.03em; text-decoration: none; color: var(--baits-pink); }
  ul { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
  ul a { font-family: var(--font-label); font-size: var(--fs-label); letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; opacity: 0.8; }
  ul a:hover { opacity: 1; color: var(--baits-yellow); }
  .nav__cta { background: var(--baits-yellow); color: var(--baits-chocolate); font-family: var(--font-title); font-weight: 800; padding: 10px 20px; border-radius: 999px; text-decoration: none; }
  .nav__cta:hover { background: var(--baits-pink); }
  .nav__progress { height: 2px; margin: 8px 28px 0; background: transparent; }
  .nav__progress span { display: block; height: 100%; background: var(--baits-yellow); transform-origin: left; transform: scaleX(0); }
  @media (max-width: 767px) { nav { display: none; } }
</style>
