---
import p from "../data/proposta.json";
---
<section id="metodo" class="section h-section metodo tone-choc corners" data-horizontal>
  <div class="wrap h-head">
    <div>
      <p class="label metodo__eyebrow">Método · Double Diamond</p>
      <h2 class="h2" data-fade>Abrir para entender. Fechar para decidir. Duas vezes.</h2>
    </div>
    <p class="label metodo__count" aria-hidden="true"><span data-counter>01</span> / 04</p>
  </div>
  <div class="h-track" data-track>
    {p.fases.map((f) => (
      <article class={`panel tone-${f.tom}`}>
        <div class="panel__top">
          <span class="label">{f.n} · {f.semanas}</span>
          <h3 class="display panel__name" data-panel-title>{f.nome}</h3>
          <p class="lead">{f.frase}</p>
        </div>
        <ul class="panel__list">
          {f.atividades.map((a) => <li>{a}</li>)}
        </ul>
        <p class="label panel__cp">{f.checkpoint}</p>
      </article>
    ))}
  </div>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
</section>

<style>
  .metodo__eyebrow { color: var(--baits-yellow); margin-bottom: 20px; }
  .metodo .h2 { color: var(--baits-pink); max-width: 16ch; }
  .metodo__count { white-space: nowrap; }
  .panel {
    width: min(86vw, 1040px); min-height: min(70vh, 640px);
    border-radius: var(--radius); padding: clamp(24px, 4vw, 56px);
    display: grid; grid-template-columns: 1.4fr 1fr; grid-template-rows: 1fr auto; gap: 32px;
  }
  .panel__name { font-size: clamp(3.5rem, 9vw, 9rem); margin: 16px 0 20px; }
  .panel__list { list-style: none; margin: 0; padding: 0; align-self: end; display: grid; gap: 10px; }
  .panel__list li { border-bottom: 1.5px solid currentColor; padding-bottom: 10px; font-weight: 500; }
  .panel__cp { grid-column: 1 / -1; }
  @media (max-width: 767px) { .panel { grid-template-columns: 1fr; min-height: 0; } }
</style>
