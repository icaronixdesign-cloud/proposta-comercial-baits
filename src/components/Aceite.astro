---
import p from "../data/proposta.json";
const aceite = `https://wa.me/${p.whatsapp}?text=${encodeURIComponent(`Olá, eu aceito a proposta da ${p.cliente}.`)}`;
const semanas = p.plano.semanas;
const dias = ["Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb"];
---
<section id="aceite" class="section aceite tone-yellow corners sheet">
  <div class="wrap aceite__grid">
    <p class="label aceite__eyebrow">Sinal 09 · Próximo passo</p>
    <h2 class="display aceite__title" data-fade data-fade-stay>Topa um desafio?</h2>
    <p class="lead aceite__lead">Aceite a proposta e marcamos o kickoff para a semana seguinte.</p>
    <div class="aceite__ctas">
      <a class="btn btn--choc" href={aceite} target="_blank" rel="noopener">
        Aceitar proposta
        <svg class="btn__icon btn__icon--right" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h11M7.5 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
      </a>
      <button type="button" class="btn" data-agenda-open aria-haspopup="dialog">Agendar conversa</button>
    </div>
    <aside class="passos tone-choc" aria-labelledby="passos-title">
      <header class="passos__head label">
        <span id="passos-title">Do aceite à entrega</span>
        <span>4 passos</span>
      </header>
      <ol class="passos__list">
        <li>
          <span class="label passos__n">01</span>
          <div><strong>Aceite</strong><p>Pelo WhatsApp, em um clique, até {p.validade}.</p></div>
        </li>
        <li>
          <span class="label passos__n">02</span>
          <div><strong>Contrato e pagamento</strong><p>À vista com 5% de desconto ou em 4 parcelas de 25%.</p></div>
        </li>
        <li>
          <span class="label passos__n">03</span>
          <div><strong>Kickoff</strong><p>Na segunda-feira seguinte, abrindo a imersão da Fase 01.</p></div>
        </li>
        <li>
          <span class="label passos__n">04</span>
          <div><strong>Entrega</strong><p>{semanas} semanas depois, com o site no ar.</p></div>
        </li>
      </ol>
    </aside>
  </div>

  <dialog class="agenda" aria-labelledby="agenda-title" data-agenda data-whatsapp={p.whatsapp} data-cliente={p.cliente} data-semanas={semanas}>
    <div class="agenda__panel">
      <header class="agenda__head">
        <div>
          <p class="label agenda__eyebrow">Agendar conversa</p>
          <h2 class="agenda__title" id="agenda-title">Escolha dia e horário</h2>
          <p class="agenda__sub">Dias úteis, das 8h às 17h30, até a entrega estimada do projeto (<span data-agenda-fim></span>).</p>
        </div>
        <button type="button" class="agenda__close" data-agenda-close aria-label="Fechar agenda">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="2" /></svg>
        </button>
      </header>

      <div class="agenda__body">
        <div class="cal">
          <div class="cal__nav">
            <button type="button" class="cal__arrow" data-cal-prev aria-label="Mês anterior">
              <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M9 2L4 7l5 5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
            </button>
            <p class="cal__month" data-cal-month aria-live="polite"></p>
            <button type="button" class="cal__arrow" data-cal-next aria-label="Próximo mês">
              <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M5 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
            </button>
          </div>
          <div class="cal__week" aria-hidden="true">{dias.map((d) => <span class="label">{d}</span>)}</div>
          <div class="cal__grid" data-cal-grid role="group" aria-label="Dias do mês"></div>
          <p class="cal__legend label" aria-hidden="true">
            <span><i class="mark mark--kick"></i>Kickoff</span>
            <span><i class="mark mark--end"></i>Entrega estimada</span>
          </p>
        </div>

        <div class="slots">
          <p class="label slots__title" data-slots-title>Horários</p>
          <div class="slots__list" data-slots role="group" aria-labelledby="slots-label"></div>
          <span class="sr-only" id="slots-label">Horários disponíveis</span>
        </div>
      </div>

      <footer class="agenda__foot">
        <p class="agenda__resumo" data-agenda-resumo aria-live="polite">Escolha um dia e um horário.</p>
        <a class="btn agenda__go" data-agenda-go target="_blank" rel="noopener" aria-disabled="true">
          Confirmar no WhatsApp
          <svg class="btn__icon btn__icon--right" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h11M7.5 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        </a>
      </footer>
    </div>
  </dialog>
</section>

<script>
  const dlg = document.querySelector<HTMLDialogElement>("[data-agenda]");
  const opener = document.querySelector<HTMLButtonElement>("[data-agenda-open]");
  if (dlg && opener) {
    const q = <T extends HTMLElement>(s: string) => dlg.querySelector<T>(s)!;
    const grid = q("[data-cal-grid]");
    const monthEl = q("[data-cal-month]");
    const prev = q<HTMLButtonElement>("[data-cal-prev]");
    const next = q<HTMLButtonElement>("[data-cal-next]");
    const slotsEl = q("[data-slots]");
    const slotsTitle = q("[data-slots-title]");
    const resumo = q("[data-agenda-resumo]");
    const go = q<HTMLAnchorElement>("[data-agenda-go]");
    const fimEl = q("[data-agenda-fim]");

    const fone = dlg.dataset.whatsapp!;
    const cliente = dlg.dataset.cliente!;
    const semanas = Number(dlg.dataset.semanas);

    const dia = (d: Date) => new Date(d.getFullYear(), d.getMonth(), d.getDate());
    const soma = (d: Date, n: number) => new Date(d.getFullYear(), d.getMonth(), d.getDate() + n);
    const iguais = (a: Date | null, b: Date | null) => !!a && !!b && a.getTime() === b.getTime();
    const util = (d: Date) => d.getDay() > 0 && d.getDay() < 6;

    // Kickoff na segunda-feira da semana seguinte; entrega na sexta da última semana do projeto
    const hoje = dia(new Date());
    const kickoff = soma(hoje, ((8 - hoje.getDay()) % 7) || 7);
    const fim = soma(kickoff, semanas * 7 - 3);
    let primeiro = soma(hoje, 1);
    while (!util(primeiro)) primeiro = soma(primeiro, 1);

    const fmtLongo = new Intl.DateTimeFormat("pt-BR", { weekday: "long", day: "numeric", month: "long" });
    const fmtCurto = new Intl.DateTimeFormat("pt-BR", { day: "2-digit", month: "2-digit", year: "numeric" });
    const fmtMes = new Intl.DateTimeFormat("pt-BR", { month: "long", year: "numeric" });
    fimEl.textContent = fmtCurto.format(fim);

    // 08:00 a 17:30, de 30 em 30 minutos
    const horarios: string[] = [];
    for (let m = 8 * 60; m <= 17 * 60 + 30; m += 30)
      horarios.push(`${String(Math.floor(m / 60)).padStart(2, "0")}:${String(m % 60).padStart(2, "0")}`);

    let mes = new Date(primeiro.getFullYear(), primeiro.getMonth(), 1);
    let escolhido: Date | null = null;
    let hora: string | null = null;

    const disponivel = (d: Date) => util(d) && d >= primeiro && d <= fim;

    function renderCal() {
      const label = fmtMes.format(mes);
      monthEl.textContent = label.charAt(0).toUpperCase() + label.slice(1);
      prev.disabled = mes <= new Date(primeiro.getFullYear(), primeiro.getMonth(), 1);
      next.disabled = mes >= new Date(fim.getFullYear(), fim.getMonth(), 1);

      grid.replaceChildren();
      const vazios = mes.getDay();
      for (let i = 0; i < vazios; i++) grid.append(document.createElement("span"));
      const total = new Date(mes.getFullYear(), mes.getMonth() + 1, 0).getDate();
      for (let n = 1; n <= total; n++) {
        const d = new Date(mes.getFullYear(), mes.getMonth(), n);
        const b = document.createElement("button");
        b.type = "button";
        b.className = "cal__day";
        b.textContent = String(n);
        b.setAttribute("aria-label", fmtLongo.format(d));
        if (!disponivel(d)) b.disabled = true;
        if (!util(d)) b.classList.add("is-weekend");
        if (iguais(d, hoje)) b.classList.add("is-today");
        if (iguais(d, kickoff)) b.classList.add("is-kick");
        if (iguais(d, fim)) b.classList.add("is-end");
        const sel = iguais(d, escolhido);
        b.setAttribute("aria-pressed", String(sel));
        b.addEventListener("click", () => {
          escolhido = d;
          renderCal();
          renderSlots();
          atualiza();
          grid.querySelector<HTMLButtonElement>('[aria-pressed="true"]')?.focus();
        });
        grid.append(b);
      }
    }

    function renderSlots() {
      slotsEl.replaceChildren();
      slotsTitle.textContent = escolhido
        ? fmtLongo.format(escolhido).replace(/^./, (c) => c.toUpperCase())
        : "Horários";
      horarios.forEach((h) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "slot";
        b.textContent = h;
        b.disabled = !escolhido;
        b.setAttribute("aria-pressed", String(h === hora));
        b.addEventListener("click", () => {
          hora = h;
          slotsEl.querySelectorAll(".slot").forEach((s) => s.setAttribute("aria-pressed", String(s === b)));
          atualiza();
        });
        slotsEl.append(b);
      });
    }

    function atualiza() {
      if (!escolhido || !hora) {
        resumo.textContent = escolhido ? "Agora escolha um horário." : "Escolha um dia e um horário.";
        go.removeAttribute("href");
        go.setAttribute("aria-disabled", "true");
        return;
      }
      resumo.innerHTML = "";
      resumo.append("Sua conversa fica para ");
      const s = document.createElement("strong");
      s.textContent = `${fmtLongo.format(escolhido)}, às ${hora}`;
      resumo.append(s, ".");
      const msg = `Olá! Gostaria de agendar uma conversa sobre a proposta da ${cliente} para ${fmtLongo.format(escolhido)} (${fmtCurto.format(escolhido)}), às ${hora}.`;
      go.href = `https://wa.me/${fone}?text=${encodeURIComponent(msg)}`;
      go.removeAttribute("aria-disabled");
    }

    prev.addEventListener("click", () => { mes = new Date(mes.getFullYear(), mes.getMonth() - 1, 1); renderCal(); });
    next.addEventListener("click", () => { mes = new Date(mes.getFullYear(), mes.getMonth() + 1, 1); renderCal(); });
    go.addEventListener("click", (e) => { if (go.getAttribute("aria-disabled")) e.preventDefault(); });

    const fechar = () => dlg.close();
    opener.addEventListener("click", () => {
      renderCal();
      renderSlots();
      atualiza();
      dlg.showModal();
      window.dispatchEvent(new Event("baits:scroll-lock"));
    });
    q("[data-agenda-close]").addEventListener("click", fechar);
    dlg.addEventListener("click", (e) => { if (e.target === dlg) fechar(); });
    dlg.addEventListener("close", () => window.dispatchEvent(new Event("baits:scroll-unlock")));
  }
</script>

<style>
  .aceite { overflow: hidden; }
  .aceite__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(240px, 30vw, 480px);
    grid-template-areas:
      "eyebrow visual"
      "title   visual"
      "lead    visual"
      "ctas    visual";
    column-gap: clamp(24px, 4vw, 72px);
    row-gap: clamp(20px, 2.4vw, 32px);
    align-items: end;
  }
  .aceite__eyebrow { grid-area: eyebrow; }
  .aceite__title { grid-area: title; max-width: 8ch; }
  .aceite__lead { grid-area: lead; }
  .aceite__ctas { grid-area: ctas; display: flex; gap: 12px; flex-wrap: wrap; }
  /* Passos do aceite: a mesma ficha da Hero, agora em chocolate */
  .passos {
    grid-area: visual; align-self: end;
    border-radius: var(--radius);
    padding: clamp(20px, 2vw, 32px);
    display: grid; gap: clamp(8px, 1.4vh, 14px);
  }
  .passos__head {
    display: flex; justify-content: space-between; gap: 12px;
    padding-bottom: 12px; border-bottom: 1.5px solid currentColor;
    color: var(--baits-yellow);
  }
  .passos__list { list-style: none; margin: 0; padding: 0; display: grid; }
  .passos__list li {
    display: grid; grid-template-columns: 2.6em 1fr; gap: 12px;
    padding-block: clamp(12px, 1.8vh, 18px);
    border-bottom: 1px solid color-mix(in srgb, var(--baits-pink-50) 18%, transparent);
  }
  .passos__list li:last-child { border-bottom: 0; padding-bottom: 0; }
  .passos__n { color: var(--baits-pink); padding-top: 0.3em; }
  .passos__list strong {
    display: block; margin-bottom: 4px;
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(1.25rem, 1.6vw, 1.625rem); line-height: 1.05; letter-spacing: -0.02em;
    color: var(--baits-pink-50);
  }
  .passos__list p { line-height: 1.45; }
  @media (max-width: 900px) {
    .aceite__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "eyebrow" "title" "lead" "ctas" "visual";
    }
    .passos { margin-top: 16px; }
  }
  @media (max-width: 480px) {
    .aceite__ctas .btn { width: 100%; }
  }

  /* ---------- Agenda (overlay) ---------- */
  .agenda {
    --line: color-mix(in srgb, var(--baits-pink) 22%, transparent);
    --soft: color-mix(in srgb, var(--baits-pink-50) 62%, transparent);
    --focus: var(--baits-yellow);
    width: min(860px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0; border: 0; border-radius: var(--radius);
    background: transparent; color: var(--baits-pink-50);
    overflow: visible;
    opacity: 0; translate: 0 16px; scale: 0.98;
    transition: opacity 0.35s var(--ease-out), translate 0.5s var(--ease-out), scale 0.5s var(--ease-out),
      overlay 0.35s allow-discrete, display 0.35s allow-discrete;
  }
  .agenda[open] { opacity: 1; translate: none; scale: 1; }
  @starting-style { .agenda[open] { opacity: 0; translate: 0 16px; scale: 0.98; } }
  .agenda::backdrop {
    background: color-mix(in srgb, var(--baits-chocolate-90) 72%, transparent);
    backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity 0.35s var(--ease-out), overlay 0.35s allow-discrete, display 0.35s allow-discrete;
  }
  .agenda[open]::backdrop { opacity: 1; }
  @starting-style { .agenda[open]::backdrop { opacity: 0; } }

  .agenda__panel {
    display: flex; flex-direction: column;
    max-height: calc(100dvh - 32px);
    border-radius: var(--radius);
    background: linear-gradient(160deg, color-mix(in srgb, var(--baits-chocolate) 92%, var(--baits-pink)) 0%, var(--baits-chocolate-90) 70%);
    border: 1.5px solid var(--line);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }
  .agenda__head {
    display: flex; justify-content: space-between; align-items: start; gap: 16px;
    padding: clamp(20px, 2.4vw, 32px) clamp(20px, 2.4vw, 32px) 0;
  }
  .agenda__eyebrow { color: var(--baits-yellow); margin-bottom: 8px; }
  .agenda__title { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1; letter-spacing: -0.03em; color: var(--baits-pink); }
  .agenda__sub { margin-top: 10px; color: var(--soft); font-size: 0.95rem; max-width: 52ch; }
  .agenda__close {
    flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    border: 1.5px solid var(--line); background: transparent; color: inherit; cursor: pointer;
    transition: background-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }
  .agenda__close:hover { background: var(--baits-pink); color: var(--baits-chocolate); }

  .agenda__body {
    display: grid; grid-template-columns: minmax(0, 1fr) 200px;
    margin-top: clamp(16px, 2vw, 24px);
    border-top: 1.5px solid var(--line);
    min-height: 0; flex: 1 1 auto;
  }

  .cal { padding: clamp(16px, 2vw, 28px); }
  .cal__nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .cal__month { font-family: var(--font-title); font-weight: 700; font-size: 1.125rem; }
  .cal__arrow {
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px;
    border: 0; background: transparent; color: inherit; cursor: pointer;
    transition: background-color 0.3s var(--ease-out);
  }
  .cal__arrow:hover:not(:disabled) { background: color-mix(in srgb, var(--baits-pink) 14%, transparent); }
  .cal__arrow:disabled { opacity: 0.25; cursor: default; }
  .cal__week, .cal__grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; text-align: center; }
  .cal__week { margin-bottom: 6px; color: var(--soft); }
  .cal__week .label { letter-spacing: 0.08em; }

  .cal__grid :global(.cal__day) {
    position: relative; aspect-ratio: 1; max-height: 48px; width: 100%;
    display: grid; place-items: center;
    border: 0; border-radius: 12px; background: transparent; color: inherit;
    font-family: var(--font-title); font-weight: 600; font-size: 0.95rem; font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: background-color 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }
  .cal__grid :global(.cal__day:hover:not(:disabled)) { background: color-mix(in srgb, var(--baits-pink) 16%, transparent); }
  .cal__grid :global(.cal__day:disabled) { opacity: 0.3; cursor: default; }
  .cal__grid :global(.cal__day.is-weekend) { text-decoration: line-through; }
  .cal__grid :global(.cal__day.is-today) { box-shadow: inset 0 0 0 1.5px var(--line); }
  .cal__grid :global(.cal__day[aria-pressed="true"]) { background: var(--baits-pink); color: var(--baits-chocolate); opacity: 1; }
  .cal__grid :global(.cal__day.is-kick)::after,
  .cal__grid :global(.cal__day.is-end)::after {
    content: ""; position: absolute; left: 30%; right: 30%; bottom: 6px; height: 3px; border-radius: 3px;
  }
  .cal__grid :global(.cal__day.is-kick)::after { background: var(--baits-yellow); }
  .cal__grid :global(.cal__day.is-end)::after { background: var(--baits-coral); }

  .cal__legend { display: flex; gap: 20px; margin-top: 14px; color: var(--soft); letter-spacing: 0.08em; }
  .cal__legend span { display: inline-flex; align-items: center; gap: 8px; }
  .mark { display: inline-block; width: 14px; height: 3px; border-radius: 3px; }
  .mark--kick { background: var(--baits-yellow); }
  .mark--end { background: var(--baits-coral); }

  .slots { border-left: 1.5px solid var(--line); display: flex; flex-direction: column; min-height: 0; }
  .slots__title { padding: clamp(16px, 2vw, 28px) 20px 12px; color: var(--baits-yellow); letter-spacing: 0.08em; }
  .slots__list {
    display: grid; gap: 8px; align-content: start;
    padding: 0 20px 20px; overflow-y: auto; max-height: 372px; overscroll-behavior: contain;
    scrollbar-width: thin; scrollbar-color: var(--line) transparent;
  }
  .slots__list :global(.slot) {
    min-height: 42px; border-radius: 12px;
    border: 1.5px solid var(--line); background: color-mix(in srgb, var(--baits-chocolate-90) 60%, transparent);
    color: inherit; font-family: var(--font-title); font-weight: 600; font-variant-numeric: tabular-nums; cursor: pointer;
    transition: background-color 0.25s var(--ease-out), border-color 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }
  .slots__list :global(.slot:hover:not(:disabled)) { border-color: var(--baits-pink); }
  .slots__list :global(.slot:disabled) { opacity: 0.3; cursor: default; }
  .slots__list :global(.slot[aria-pressed="true"]) { background: var(--baits-pink); border-color: var(--baits-pink); color: var(--baits-chocolate); }

  .agenda__foot {
    display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    padding: 16px clamp(20px, 2.4vw, 32px);
    border-top: 1.5px solid var(--line);
  }
  .agenda__resumo { flex: 1 1 260px; color: var(--soft); }
  .agenda__resumo :global(strong) { color: var(--baits-pink-50); font-weight: 600; }
  .agenda__go { background: var(--baits-pink); color: var(--baits-chocolate); border-color: var(--baits-pink); min-height: 48px; }
  .agenda__go:hover { background: var(--baits-yellow); border-color: var(--baits-yellow); color: var(--baits-chocolate); }
  .agenda__go[aria-disabled="true"] { opacity: 0.35; pointer-events: none; }

  @media (max-width: 680px) {
    .agenda__body { grid-template-columns: 1fr; overflow-y: auto; }
    .slots { border-left: 0; border-top: 1.5px solid var(--line); }
    .slots__list { grid-template-columns: repeat(4, minmax(0, 1fr)); max-height: none; overflow: visible; }
    .agenda__go { width: 100%; }
  }
</style>
