---
import p from "../data/proposta.json";
import { hasPublic } from "../lib/assets";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const hasPdf = hasPublic(p.pdf);
// Braian 3D: giro renderizado no Blender (31 quadros, de −35° a +35°; o 15 é de frente)
const FRAMES = 31;
const FRONT = 15;
const frameDir = `${base}/img/braian-3d`;
const has3d = hasPublic("img/braian-3d/f15.webp");
const frame = (i: number) => `${frameDir}/f${String(i).padStart(2, "0")}.webp`;
---
<section id="topo" class="hero tone-choc corners">
  <div class="wrap hero__grid">
    <p class="label hero__eyebrow" data-fade>Proposta comercial · Nutrição cognitiva</p>
    <h1 class="display hero__title" data-fade>
      Se o músculo tem nutrição, <em>por que a mente não?</em>
    </h1>
    <div class="hero__foot" data-hero-in>
      <dl class="hero__meta label">
        <div><dt>Cliente</dt><dd>{p.cliente}</dd></div>
        <div><dt>Proponente</dt><dd>{p.proponente}</dd></div>
        <div><dt>Data</dt><dd>{p.data}</dd></div>
        <div><dt>Válida até</dt><dd>{p.validade}</dd></div>
      </dl>
      <div class="hero__ctas">
        <a class="btn btn--solid" href="#investimento">
          Ver investimento
          <svg class="btn__icon btn__icon--down" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1v11M2 7.5 7 12.5l5-5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        </a>
        {hasPdf && (
          <a class="btn" href={`${base}/${p.pdf}`} download>
            Baixar PDF
            <svg class="btn__icon btn__icon--down" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1v8M3 5.5 7 9.5l4-4M1.5 13h11" fill="none" stroke="currentColor" stroke-width="2" /></svg>
          </a>
        )}
      </div>
    </div>

    <figure class="stage3d" aria-hidden="true" data-hero-visual>
      <span class="stage3d__disc" data-hero-disc></span>
      <span class="stage3d__ring"></span>
      {has3d && (
        <span class="stage3d__char" data-hero-char>
          <span class="stage3d__float" data-braian3d data-frames={FRAMES} data-front={FRONT} data-dir={frameDir}>
            <img src={frame(FRONT)} alt="" width="1200" height="993" fetchpriority="high" decoding="async" />
          </span>
          <span class="stage3d__shadow" data-braian3d-shadow></span>
        </span>
      )}
      <span class="label stage3d__tag">Fig. 01 — Braian 3D</span>
    </figure>
  </div>
</section>

<script>
  const host = document.querySelector<HTMLElement>("[data-braian3d]");
  const hero = document.getElementById("topo");
  if (host && hero) {
    const img = host.querySelector("img")!;
    const shadow = document.querySelector<HTMLElement>("[data-braian3d-shadow]");
    const total = Number(host.dataset.frames);
    const front = Number(host.dataset.front);
    const dir = host.dataset.dir!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;

    // Pré-carrega todos os quadros depois da primeira pintura; troca de src só com quadro pronto
    const urls = Array.from({ length: total }, (_, i) => `${dir}/f${String(i).padStart(2, "0")}.webp`);
    const ready = new Array<boolean>(total).fill(false);
    ready[front] = true;
    const load = () =>
      urls.forEach((u, i) => {
        if (i === front) return;
        const im = new Image();
        im.decoding = "async";
        im.src = u;
        im.decode().then(() => (ready[i] = true), () => {});
      });
    if ("requestIdleCallback" in window) (window as any).requestIdleCallback(load, { timeout: 1500 });
    else setTimeout(load, 600);

    if (!reduce) {
      let pointer = 0; // −1 … 1
      let tiltY = 0;
      let cur = 0;
      let curTilt = 0;
      let shown = front;
      let t0 = performance.now();

      if (fine) {
        hero.addEventListener("pointermove", (e) => {
          const r = hero.getBoundingClientRect();
          pointer = ((e.clientX - r.left) / r.width) * 2 - 1;
          tiltY = ((e.clientY - r.top) / r.height) * 2 - 1;
        });
        hero.addEventListener("pointerleave", () => { pointer = 0; tiltY = 0; });
      }

      let visible = true;
      new IntersectionObserver(([en]) => (visible = en.isIntersecting)).observe(hero);

      const tick = (now: number) => {
        requestAnimationFrame(tick);
        if (!visible) return;
        const t = (now - t0) / 1000;
        const h = hero.offsetHeight || 1;
        const scroll = Math.min(1, Math.max(0, window.scrollY / h));
        // Sem cursor (toque): balança sozinho de um lado para o outro
        const idle = fine ? Math.sin(t * 0.6) * 0.12 : Math.sin(t * 0.5) * 0.55;
        const target = Math.max(-1, Math.min(1, pointer * 0.9 + idle + scroll * 0.9));
        cur += (target - cur) * 0.08;
        curTilt += (tiltY - curTilt) * 0.06;

        const idx = Math.round(front + cur * front);
        if (idx !== shown && ready[idx]) {
          img.src = urls[idx];
          shown = idx;
        }
        const bob = Math.sin(t * 1.6) * 8;
        host.style.transform =
          `translate3d(${cur * 14}px, ${bob - scroll * 90 + curTilt * 8}px, 0) rotate(${cur * 2.5}deg) scale(${1 - scroll * 0.12})`;
        if (shadow) {
          const k = 1 - (bob + 8) / 32;
          shadow.style.transform = `translateX(-50%) scale(${(k * (1 - scroll * 0.3)).toFixed(3)})`;
          shadow.style.opacity = String((0.55 * k * (1 - scroll)).toFixed(3));
        }
      };
      requestAnimationFrame(tick);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex; align-items: end;
    padding-block: clamp(104px, 15vh, 160px) clamp(56px, 9vh, 96px);
    overflow: hidden;
  }
  .hero__grid {
    display: grid; width: 100%;
    grid-template-columns: minmax(0, 1fr) clamp(300px, 40vw, 680px);
    grid-template-areas:
      "eyebrow visual"
      "title   visual"
      "foot    foot";
    column-gap: clamp(24px, 3vw, 56px);
    row-gap: clamp(20px, 3.4vh, 40px);
    align-items: end;
  }
  .hero__eyebrow { grid-area: eyebrow; color: var(--baits-yellow); position: relative; z-index: 1; }
  .hero__title {
    grid-area: title;
    font-size: clamp(3.25rem, min(8.4vw, 15vh), 11rem);
    max-width: 11ch;
    color: var(--baits-pink);
    position: relative; z-index: 1;
  }
  .hero__title em { font-style: normal; color: var(--baits-pink-50); }
  .hero__foot {
    grid-area: foot;
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 28px 48px;
    padding-top: clamp(20px, 3vh, 32px);
    border-top: 1px solid color-mix(in srgb, var(--baits-pink) 22%, transparent);
    position: relative; z-index: 1;
  }
  .hero__meta { display: grid; grid-template-columns: repeat(4, auto); gap: 12px clamp(24px, 3.5vw, 56px); margin: 0; }
  .hero__meta dt { color: color-mix(in srgb, var(--baits-pink-50) 64%, var(--baits-chocolate)); }
  .hero__meta dd { margin: 6px 0 0; color: var(--baits-pink-50); }
  .hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  /* Palco do Braian 3D: disco amarelo (o chocolate dos braços sumiria no fundo) */
  .stage3d {
    grid-area: visual; align-self: stretch;
    position: relative; margin: 0;
    height: min(58vh, 600px); min-height: 300px;
    display: grid; place-items: center;
    isolation: isolate;
  }
  /* Disco, anel e personagem na mesma célula: centralizados pelo grid, sem translate
     (o GSAP grava translate: none ao animar a entrada) */
  .stage3d > :not(.stage3d__tag) { grid-area: 1 / 1; }
  .stage3d__disc {
    position: relative; z-index: -2;
    width: min(100%, 56vh); aspect-ratio: 1; border-radius: 50%;
    margin-top: 4%;
    background:
      radial-gradient(60% 60% at 42% 36%, color-mix(in srgb, var(--baits-pink-50) 40%, var(--baits-yellow)) 0%, transparent 62%),
      var(--baits-yellow);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--baits-chocolate) 30%, transparent), 0 60px 120px -40px rgba(0, 0, 0, 0.55);
  }
  .stage3d__disc::after {
    /* retícula da marca */
    content: ""; position: absolute; inset: 0; border-radius: inherit;
    background-image: radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--baits-chocolate) 18%, transparent) 1.1px, transparent 0);
    background-size: 18px 18px;
    -webkit-mask: radial-gradient(closest-side, transparent 55%, #000 100%);
            mask: radial-gradient(closest-side, transparent 55%, #000 100%);
  }
  .stage3d__ring {
    position: relative; z-index: -3;
    width: min(116%, 68vh); aspect-ratio: 1; border-radius: 50%;
    margin-top: 4%;
    border: 1.5px dashed color-mix(in srgb, var(--baits-pink) 30%, transparent);
    animation: spin 60s linear infinite;
  }
  @keyframes spin { to { rotate: 360deg; } }

  .stage3d__char {
    position: relative; width: min(100%, 64vh); margin-top: 3%;
  }
  .stage3d__float { display: block; will-change: transform; }
  .stage3d__float img { display: block; width: 100%; height: auto; }
  .stage3d__shadow {
    position: absolute; z-index: -1; left: 50%; bottom: 1.5%;
    width: 30%; height: 5%; border-radius: 50%;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(61, 16, 16, 0.55), transparent);
  }
  .stage3d__tag {
    position: absolute; right: 0; bottom: 0;
    color: color-mix(in srgb, var(--baits-pink-50) 60%, transparent);
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "visual" "eyebrow" "title" "foot";
    }
    .stage3d { min-height: 0; height: min(48svh, 100vw); }
    .stage3d__disc { width: min(84vw, 46svh); }
    .stage3d__ring { width: min(100vw, 56svh); }
    .stage3d__char { width: min(90vw, 50svh); margin-top: 10%; }
    .stage3d__tag { display: none; }
    .hero__meta { grid-template-columns: repeat(2, auto); }
  }
  @media (max-width: 480px) {
    .hero__ctas, .hero__ctas .btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage3d__ring { animation: none; }
  }
</style>
