---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<div class="personagem" data-character data-base={base} aria-hidden="true">
  <canvas data-canvas></canvas>
</div>
<script>
  const host = document.querySelector<HTMLElement>("[data-character]");
  if (host) {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      import("../scripts/personagem").then(({ initCharacter }) => initCharacter(host)).catch(() => {});
    }, { rootMargin: "300px" });
    observer.observe(host);
  }
</script>
<style>
  .personagem {
    position: absolute; bottom: 100%; left: var(--margin);
    width: clamp(260px, 30vw, 460px); height: 124px;
    pointer-events: none; z-index: 1;
  }
  .personagem canvas { display: block; width: 100%; height: 100%; opacity: 0; transition: opacity 0.4s ease; }
  .personagem.is-ready canvas { opacity: 1; }
  @media (max-width: 900px) {
    .personagem { width: min(75vw, 360px); height: 96px; }
  }
</style>
