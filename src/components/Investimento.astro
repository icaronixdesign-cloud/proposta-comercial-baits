---
import p from "../data/proposta.json";
const brl = (n: number) => n.toLocaleString("pt-BR");
const k = p.plano;
const vista = Math.round(k.valor * 0.95);
const economia = k.valor - vista;
const parcela = Math.round(k.valor / 4);
---
<section id="investimento" class="section investimento tone-pink50 corners sheet" data-investimento>
  <div class="wrap investimento__inner">
    <div class="investimento__head">
      <p class="label eyebrow">Sinal 06 · Investimento</p>
      <h2 class="h2 investimento__title" data-fade>Um projeto. Um investimento.</h2>
    </div>

    <div class="investimento__grid">
      <article class:list={["plan", `tone-${k.tom}`]} data-card>
        <header class="plan__head">
          <span class="label plan__rotulo">{k.rotulo}</span>
          <h3 class="plan__name">{k.nome}</h3>
          <p class="label">{k.semanas} semanas · {k.horas} horas</p>
        </header>
        <ul class="plan__list">{k.itens.map((i) => <li>{i}</li>)}</ul>
      </article>

      <aside class="pay tone-choc" data-card aria-labelledby="pay-title">
        <p class="label pay__eyebrow" id="pay-title">Forma de pagamento</p>

        <div class="pay__total">
          <span class="label">Total do projeto</span>
          <s class="pay__full">R$ {brl(k.valor)}</s>
        </div>

        <div class="pay__main">
          <span class="label pay__badge">À vista na assinatura · −5%</span>
          <p class="pay__price">
            <span class="sr-only">R$ {brl(vista)}</span>
            <span aria-hidden="true">
              <span class="pay__cur">R$</span>
              <span data-count={vista}>{brl(vista)}</span>
            </span>
          </p>
          <p class="pay__note">Economia de R$ {brl(economia)} no pagamento integral na assinatura.</p>
        </div>

        <div class="pay__alt">
          <span class="label">Ou parcelado</span>
          <p><strong>4 × R$ {brl(parcela)}</strong> <span>(25% cada, sem desconto)</span></p>
        </div>
      </aside>
    </div>

    <p class="label investimento__foot">Taxa-hora R$ 180 · impostos inclusos · válida até {p.validade}</p>
  </div>
</section>

<style>
  /* Tudo em uma tela no desktop */
  .investimento { padding-block: clamp(88px, 11vh, 128px) clamp(48px, 7vh, 88px); }
  @media (min-width: 901px) and (min-height: 640px) {
    .investimento { min-height: 100vh; display: flex; align-items: center; }
    .investimento__inner { width: 100%; }
  }
  .investimento__title { max-width: 18ch; font-size: min(var(--fs-h2), 8vh); }
  .investimento__grid {
    display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: var(--gutter); margin-top: clamp(28px, 4.5vh, 56px); align-items: stretch;
  }

  .plan {
    border-radius: var(--radius); border: 2px solid var(--baits-chocolate);
    padding: clamp(24px, 2.4vw, 40px);
    display: grid; gap: clamp(20px, 3vh, 32px); align-content: space-between;
  }
  .plan__head { display: grid; gap: 10px; }
  .plan__rotulo { justify-self: start; background: var(--baits-chocolate); color: var(--baits-yellow); padding: 6px 12px; border-radius: 999px; }
  .plan__name { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.5rem, min(5vw, 9vh), 5rem); line-height: 1; letter-spacing: -0.035em; }
  .plan__list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gutter);
  }
  .plan__list li { border-top: 1.5px solid currentColor; padding-block: clamp(8px, 1.3vh, 12px); }

  .pay {
    border-radius: var(--radius); border: 2px solid var(--baits-chocolate);
    padding: clamp(24px, 2.4vw, 40px);
    display: flex; flex-direction: column; gap: clamp(18px, 2.6vh, 28px);
  }
  .pay__eyebrow { color: var(--baits-yellow); }
  .pay__total { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-bottom: clamp(14px, 2vh, 22px); border-bottom: 1.5px solid color-mix(in srgb, var(--baits-pink) 35%, transparent); }
  .pay__full { font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; letter-spacing: -0.02em; color: color-mix(in srgb, var(--baits-pink-50) 70%, transparent); text-decoration-thickness: 2px; }
  .pay__main { display: grid; gap: 10px; }
  .pay__badge { justify-self: start; background: var(--baits-yellow); color: var(--baits-chocolate); padding: 6px 12px; border-radius: 999px; }
  .pay__price {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(3rem, min(5.4vw, 10vh), 5.5rem);
    line-height: 1; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; color: var(--baits-pink);
    padding-block: 6px 2px;
  }
  .pay__cur { font-size: 0.34em; letter-spacing: 0; vertical-align: top; margin-right: 8px; position: relative; top: 0.2em; }
  .pay__note { color: color-mix(in srgb, var(--baits-pink-50) 85%, transparent); max-width: 32ch; }
  .pay__alt { margin-top: auto; display: grid; gap: 6px; padding-top: clamp(14px, 2vh, 22px); border-top: 1.5px solid color-mix(in srgb, var(--baits-pink) 35%, transparent); }
  .pay__alt .label { color: var(--baits-yellow); }
  .pay__alt strong { font-family: var(--font-title); font-size: 1.25rem; }
  .pay__alt span:not(.label) { color: color-mix(in srgb, var(--baits-pink-50) 75%, transparent); }

  .investimento__foot { margin-top: clamp(20px, 3vh, 36px); }

  @media (max-width: 900px) {
    .investimento__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .plan__list { grid-template-columns: 1fr; }
  }
</style>
